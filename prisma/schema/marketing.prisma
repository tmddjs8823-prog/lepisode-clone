// ============================================================
// 마케팅 (수신동의 + 업체 관리)
// ============================================================

model MarketingConsent {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  phone       String?
  isConsented Boolean   @default(true)
  consentedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("marketing_consents")
}

model MarketingCompany {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  manager       String?
  monthlyBudget Int      @default(0)
  password      String?
  status        String   @default("활성")

  // 네이버 검색광고
  naverApiKey      String?
  naverSecretKey   String?
  naverCustomerId  String?
  chPowerlink      Boolean @default(false)
  chPowerContent   Boolean @default(false)
  chPlace          Boolean @default(false)

  // GA4
  ga4PropertyId        String?
  ga4ServiceAccountKey String? @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("marketing_companies")
}

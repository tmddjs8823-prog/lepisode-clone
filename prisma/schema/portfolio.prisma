// ============================================================
// 포트폴리오
// ============================================================

model Portfolio {
  id            Int      @id @default(autoincrement())
  title         String
  titleEn       String?
  titleJa       String?
  client        String?
  category      String
  period        String?
  techStack     String[] // PostgreSQL array
  keywords      String?  // 검색 키워드 (콤마 구분)
  thumbnailUrl  String?
  images        String[] // PostgreSQL array of URLs
  description   String?  @db.Text
  descriptionEn String?  @db.Text
  descriptionJa String?  @db.Text
  published     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("portfolios")
}
